{
  "name": "cgreg-virtual-office",
  "version": "1.0.0",
  "private": true,
  "description": "CGREG Virtual Office — Centro Digital de Operaciones de Atención Interdisciplinaria",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file=.env server/cli/migrate.ts",
    "user:create": "tsx --env-file=.env server/cli/create-user.ts",
    "sheets:check": "tsx --env-file=.env server/cli/sheets-check.ts",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs && node e2e/movimiento.mjs && node e2e/app-movil.mjs && node e2e/brigada.mjs",
    "e2e:brigada": "node e2e/brigada.mjs",
    "demo:verificar-permisos": "tsx scripts/demo/verificar-permisos.ts",
    "e2e:movimiento": "node e2e/movimiento.mjs",
    "push:claves": "tsx server/cli/push-claves.ts",
    "e2e:movil": "node e2e/app-movil.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.2",
    "@fastify/websocket": "^11.0.1",
    "@react-three/drei": "^9.115.0",
    "@react-three/fiber": "^8.17.10",
    "@tanstack/react-query": "^5.59.20",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.1.0",
    "google-auth-library": "^9.15.0",
    "lucide-react": "^0.454.0",
    "luxon": "^3.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.169.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "ws": "^8.18.0"
  }
}
