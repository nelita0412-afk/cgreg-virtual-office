{
  "name": "CGREG Virtual Office",
  "short_name": "CGREG Office",
  "description": "Acompañamiento psicosocial y de salud para servidores del CGREG en Santa Cruz, Galápagos.",
  "id": "/",
  "start_url": "/?origen=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "es-EC",
  "dir": "ltr",
  "background_color": "#F5F3EC",
  "theme_color": "#F5F3EC",
  "categories": ["medical", "productivity", "government"],
  "icons": [
    { "src": "/icons/icono-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icono-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Mi día", "url": "/inicio", "icons": [{ "src": "/icons/icono-192.png", "sizes": "192x192" }] },
    { "name": "Agenda", "url": "/agenda", "icons": [{ "src": "/icons/icono-192.png", "sizes": "192x192" }] },
    { "name": "Solicitudes", "url": "/solicitudes", "icons": [{ "src": "/icons/icono-192.png", "sizes": "192x192" }] },
    { "name": "Solicitar atención", "url": "/servidor", "icons": [{ "src": "/icons/icono-192.png", "sizes": "192x192" }] }
  ]
}
