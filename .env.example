# ---- Servidor ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://cgreg:CAMBIAR@localhost:5432/cgreg_office
# Genere con: openssl rand -base64 32  (¡no la pierda: cifra la información clínica!)
DATA_ENCRYPTION_KEY=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# En producción detrás de HTTPS: COOKIE_SECURE=true y TRUST_PROXY=true si hay proxy inverso
# COOKIE_SECURE=true
# TRUST_PROXY=true

# ---- Google Sheets (solo lectura, pestaña gid 133021335 «Valoraciones») ----
SHEETS_SPREADSHEET_ID=1hsrY0A8tqXUUDLuNK4Y3Sr_BFFhUjt5Hfw9kEo8DguE
SHEETS_GID=133021335
SHEETS_SYNC_INTERVAL_SECONDS=60
SHEETS_SYNC_ENABLED=true
# Una de las dos opciones:
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/cuenta-servicio.json
# Mapeo opcional campo→encabezado (por defecto los encabezados verificados de «Valoraciones»):
# SHEETS_COLUMNS={"nombre":"Servidor"}

# Pestaña maestra de personal identificada por metadatos: «Personal» (gid 1340025527).
# Con este valor se usa la base maestra (filtrada a Santa Cruz) + «Valoraciones». Vacío = solo «Valoraciones».
SHEETS_MAESTRA_GID=1340025527
# «Personal» no tiene columna de ubicación laboral: el filtro usa la unidad orgánica registrada (confirmar).
SHEETS_UBICACION_COLUMNA=Unidad_Organica
SHEETS_UBICACION_VALOR=SANTA CRUZ
# Clasificación de riesgo: «Valoraciones» NO tiene hoy un campo explícito. Configurar SOLO cuando la institución
# confirme la columna y los valores que registran la clasificación profesional de riesgo alto.
# SHEETS_RIESGO_COLUMNA=
# SHEETS_RIESGO_VALORES=ALTO,ALTA,RIESGO ALTO
# SHEETS_SEGUIMIENTO_COLUMNA=

# ---- Consentimiento informado ----
# «Constancia profesional» (registro sin documento, modalidad previa a la ampliación). Por defecto NO habilita la atención.
CONSENTIMIENTO_CONSTANCIA_PROFESIONAL=false
CONSENTIMIENTO_TOKEN_HORAS=72
DOCUMENTO_MAX_MB=10

# ---- Atención abierta ----
FORMULARIO_PUBLICO_HABILITADO=true

PRESENCE_TIMEOUT_SECONDS=45
